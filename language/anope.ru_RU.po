msgstr "Подписывать кики, выполненные командой KICK"

#: ../modules/chanserv/cs_set.cpp
#, c-format
msgid "Signed kick option for %s is now off."
msgstr "Опция подписанного кика для %s теперь выключена."

#: ../modules/chanserv/cs_set.cpp
#, c-format
msgid "Signed kick option for %s is now on, but depends of the level of the user that is using the command."
msgstr "Опция подписанного кика для %s теперь включена, но зависит от уровня пользователя, использующего команду."

#: ../modules/chanserv/cs_set.cpp
#, c-format
msgid "Signed kick option for %s is now on."
msgstr "Опция подписанного кика для %s теперь включена."

#: ../modules/chanserv/cs_set.cpp
msgid "Signed kicks"
msgstr "Подписанные кики"

