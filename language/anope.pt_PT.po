msgstr "A opção de kick assinado para %s está agora ativada."

msgid "Signed kicks"
msgstr "Kicks assinados"

msgid "State"
msgstr "Estado"

msgid "Statistics and maintenance for seen data"
msgstr "Estatísticas e manutenção para dados de 'visto'"

