#~ "    DEBUG      Activate or deactivate debug mode\n"
#~ "    NOEXPIRE   Activate or deactivate no expire mode\n"
#~ "    SUPERADMIN Activate or deactivate super admin mode\n"
#~ "    LIST       List the options"
